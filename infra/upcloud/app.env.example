# These infrastructure keys must NOT be present here because compose.yml owns them:
# DATABASE_URL, REDIS_URL, API_BASE_URL, API_PORT, PORT,
# GENERATION_LOG_DATABASE_URL, START_WORKER, NEWSWEB_POLLING_ENABLED, NODE_OPTIONS.

