[Unit]
Description=Autoweb monthly PostgreSQL restore drill
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=autoweb
Group=autoweb
WorkingDirectory=/srv/autoweb/current/infra/upcloud
Environment=AUTOWEB_ROOT=/srv/autoweb
ExecStart=/srv/autoweb/current/infra/upcloud/scripts/restore-drill.sh
