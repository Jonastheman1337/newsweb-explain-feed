[Unit]
Description=Autoweb nightly PostgreSQL logical backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=autoweb
Group=autoweb
WorkingDirectory=/srv/autoweb/current/infra/upcloud
Environment=AUTOWEB_ROOT=/srv/autoweb
LoadCredential=host.env:/srv/autoweb/secrets/host.env
Environment=HOST_ENV=%d/host.env
ExecStart=/srv/autoweb/current/infra/upcloud/scripts/backup.sh
