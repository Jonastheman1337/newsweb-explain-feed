[Unit]
Description=Autoweb local infrastructure watchdog
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=autoweb
Group=autoweb
WorkingDirectory=/srv/autoweb/current/infra/upcloud
Environment=AUTOWEB_ROOT=/srv/autoweb
ExecStart=/srv/autoweb/current/infra/upcloud/scripts/watchdog.sh
