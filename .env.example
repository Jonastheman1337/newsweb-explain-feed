DATABASE_URL="postgresql://newsweb:newsweb@localhost:5432/newsweb_explain?schema=public"
GENERATION_LOG_DATABASE_URL=""
REDIS_URL="redis://localhost:6379"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_ADMIN_KEY=""
OPENAI_MODEL="gpt-5.6-terra"
OPENAI_FAST_MODEL="gpt-5.6-luna"
OPENAI_HARD_MODEL="gpt-5.6-sol"
OPENAI_SERVICE_TIER="default"
OPENAI_TIMEOUT_MS="240000"
OPENAI_FAST_TIMEOUT_MS="15000"
OPENAI_DEFAULT_REASONING_EFFORT="medium"
OPENAI_REPORT_REASONING_EFFORT="medium"
OPENAI_HARD_REASONING_EFFORT="xhigh"
OPENAI_TRIAGE_REASONING_EFFORT="none"
OPENAI_REFERENCE_REASONING_EFFORT="medium"
OPENAI_REVIEW_REASONING_EFFORT="medium"
OPENAI_PROMPT_CACHE_MODE="implicit"
# /sak (long-form drafts from uploaded materials): first draft effort, per-call
# timeout, and the draft lifetime enforced by the worker's expiry sweep.
OPENAI_SAK_REASONING_EFFORT="high"
OPENAI_SAK_TIMEOUT_MS="360000"
SAK_TTL_HOURS="24"
# Per-flow cache overrides (implicit | explicit | off); unset means the global mode:
# OPENAI_PROMPT_CACHE_MODE_SAK="implicit"
# OPENAI_PROMPT_CACHE_MODE_PDF_CONTEXT="off"
# OPENAI_PROMPT_CACHE_MODE_REFERENCE_CHECK="off"
# OPENAI_PROMPT_CACHE_MODE_REWRITE_REGULAR="explicit"
# OPENAI_PROMPT_CACHE_MODE_REWRITE_REPORT="explicit"
# OPENAI_PROMPT_CACHE_MODE_REWRITE_YEARLY="explicit"
# OPENAI_PROMPT_CACHE_MODE_TRIAGE="implicit"
# OPENAI_PROMPT_CACHE_MODE_EDITORIAL_REVIEW="implicit"
# Numeric derivation-rule kill switch. Semantics differ from the cache envs:
# UNSET = the code default (defaultEnabledDerivationRules in prompt-kit; what
# CI safety gates replay). SET = the exact enabled set, so "" turns every
# derivation rule off with no deploy. Ids beyond the code default boot with a
# warning (prod-only, unverified by gates). Unknown ids fail at boot.
# NUMERIC_ACCEPTANCE_RULES=""
# Emergency kill-switch for the promoted checker enforcement
# (defaultReferenceCheckEnforcement in worker services/reference-check.ts).
# Same semantics: UNSET = code default; SET = the exact enabled flag set, so
# "" restores the full legacy fail-open with no deploy. Known flags:
# block_on_residual_unsupported, retry_on_unavailable. Unknown flags fail at
# boot.
# REFERENCE_CHECK_ENFORCEMENT=""
POLL_INTERVAL_MS="5000"
LATEST_BOOTSTRAP_COUNT="30"
API_PORT="4000"
WEB_PORT="3000"
API_BASE_URL="http://localhost:4000"
SESSION_SECRET="change-this-to-at-least-24-characters"
DEV_AUTH_BYPASS="false"
MAGIC_LINK_BASE_URL="http://localhost:3000/login"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"
ADMIN_API_KEY="change-me"
RENDER_DATABASE_EXTERNAL_URL=""
RENDER_LOG_DATABASE_EXTERNAL_URL=""
